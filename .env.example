# Canonical site URL — used for canonical links, Open Graph, JSON-LD, sitemap.xml
# and robots.txt. Inlined at build time: pass it as a Docker build arg
# (--build-arg NEXT_PUBLIC_SITE_URL=...), or set it in .env.local for local builds.
# On Vercel, leave it unset: the project's production domain
# (VERCEL_PROJECT_PRODUCTION_URL) is used. Set it there only for a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: the token from Google Search Console's "HTML tag" verification method
# (the content="..." value only). Read when pages render: on Vercel, add it under
# Settings → Environment Variables (Production), then redeploy.
GOOGLE_SITE_VERIFICATION=

# Optional: a GitHub token (no scopes needed) for the GitHub section's live repo
# metadata. Without it, requests share GitHub's 60-an-hour unauthenticated limit;
# when the API is unavailable the section shows its curated descriptions instead.
GITHUB_TOKEN=
